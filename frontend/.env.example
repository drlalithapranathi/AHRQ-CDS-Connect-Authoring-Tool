# API Configuration
REACT_APP_API_URL=/authoring/api

# Branding Configuration (optional)
# Set REACT_APP_BRANDING_ENABLED=true to show the institutional header
# If not enabled, the entire header section (including US flag) will be hidden
REACT_APP_BRANDING_ENABLED=false
REACT_APP_BRANDING_IMAGE_URL=
REACT_APP_BRANDING_IMAGE_ALT=Organization logo
REACT_APP_BRANDING_TEXT=
REACT_APP_BRANDING_LINK_URL=
REACT_APP_BRANDING_COLOR=#990000

# Example: Luddy School branding
# REACT_APP_BRANDING_ENABLED=true
# REACT_APP_BRANDING_IMAGE_URL=/assets/images/luddy-logo.png
# REACT_APP_BRANDING_IMAGE_ALT=Luddy School of Informatics Logo
# REACT_APP_BRANDING_TEXT=Luddy School of Informatics
# REACT_APP_BRANDING_LINK_URL=https://luddy.indianapolis.iu.edu
# REACT_APP_BRANDING_COLOR=#990000
